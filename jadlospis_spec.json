      "space_after": 16
    },
    {
      "type": "paragraph",
      "text": "Pamiętaj o wypiciu min. 2 litrów wody dziennie! 💧",
      "style": {
        "fontSize": 11,
        "textColor": "#5297C7",
        "fontName": "Helvetica-Bold"
